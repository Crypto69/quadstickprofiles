<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Hardened runtime is required for notarisation. These two exceptions are what
       a PyInstaller app needs under it: CPython maps executable memory it did not
       sign, and loads extension modules (.so) whose signatures differ from the
       main binary's. Without them the app dies on launch with no window. -->
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
