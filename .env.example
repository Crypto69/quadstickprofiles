# copy to .env for local (non-Docker) runs of the API
#
# Required for a local run: app/settings.py has no default, so the API refuses
# to start without it. Docker compose sets it for the containers itself.
# QS_DATABASE_URL=postgresql+psycopg://quadstick:<password>@localhost:5432/quadstick
QS_EXPORTS_DIR=./exports
# docker compose
#
# REQUIRED — no default. Both compose files use ${QS_DB_PASSWORD:?...}, so
# `docker compose up` refuses to start until this has a value.
#
# NEW install: choose any password, set it here before the first start.
#
# EXISTING install: put in the password the database was already created with
# (`quadstick` if it was never changed) — NOT a new one. Postgres only applies
# this when it creates an *empty* data directory; afterwards the password lives
# inside the data directory and this variable is ignored. Setting a new value
# leaves the API using it while the database still expects the old one — the
# database starts and reports healthy, and the API fails to log in. To change
# it on an existing database:
#   docker compose exec db psql -U quadstick -d quadstick \
#     -c "alter user quadstick with password '<new>';"
QS_DB_PASSWORD=
QS_API_PORT=8325
# the app itself; open http://<nas>:8324
QS_WEB_PORT=8324

# By default the database, backups and exports live inside the checkout
# (./data/pg, ./data/backups, ./exports), so they sit on whichever volume you
# cloned onto. deploy.sh creates them.
#
# Only set these to move the data somewhere else, e.g. exports into a TOS
# share so they are reachable over SMB. Absolute paths; create them first.
# QS_EXPORTS_HOST=/path/to/a/share/quadstick-exports
# QS_BACKUP_HOST=/path/to/quadstick/backups
# QS_PGDATA_HOST=/path/to/quadstick/pgdata
